var g_retry_at: i64 = 0 as i64;

var g_b64t: [i8; 256] = [0 as i8, ...];

func init_b64_table() -> void {
    for (var i: int = 0; i < 256; i = i + 1) {
        g_b64t[i] = -1 as i8;
    }
    var chars: *char = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    for (var i: int = 0; i < 64; i = i + 1) {
        var idx: u8 = *(((chars as i64) + (i as i64)) as *u8);
        g_b64t[idx as int] = i as i8;
    }
}

func bswap64(v: u64) -> u64 {
    return ((v & (0x00000000000000FF as u64)) << 56) |
           ((v & (0x000000000000FF00 as u64)) << 40) |
           ((v & (0x0000000000FF0000 as u64)) << 24) |
           ((v & (0x00000000FF000000 as u64)) << 8) |
           ((v & (0x000000FF00000000 as u64)) >> 8) |
           ((v & (0x0000FF0000000000 as u64)) >> 24) |
           ((v & (0x00FF000000000000 as u64)) >> 40) |
           ((v & (0xFF00000000000000 as u64)) >> 56);
}

func bswap32(v: u32) -> u32 {
    return ((v & (0x000000FF as u32)) << 24) |
           ((v & (0x0000FF00 as u32)) << 8) |
           ((v & (0x00FF0000 as u32)) >> 8) |
           ((v & (0xFF000000 as u32)) >> 24);
}

func read_be64(p: *void) -> i64 {
    var raw: u64 = 0 as u64;
    memcpy((&raw) as *void, p, 8 as i64);
    return bswap64(raw) as i64;
}

func read_be32(p: *void) -> int {
    var raw: u32 = 0 as u32;
    memcpy((&raw) as *void, p, 4 as i64);
    return bswap32(raw) as int;
}

func ep_set(ep: int, op: int, fd: int, tag: u64, ev: u32) -> void {
    var e: EpollEvent = EpollEvent {
        events: ev,
        data_u64: tag
    };
    epoll_ctl(ep, op, fd, (&e) as *void);
}

func put(p: *void, n: i64) -> void {
    memcpy((g_arena as i64 + g_alen) as *void, p, n);
    g_alen = g_alen + n;
}

func puts_lit(s: *char) -> void {
    put(s as *void, strlen(s));
}

func put_u64(v: u64) -> void {
    var b: [char; 24] = uninit;
    var i: int = 24;
    var x: u64 = v;
    for (;;) {
        i = i - 1;
        b[i] = ((48 as u64) + (x % (10 as u64))) as char;
        x = x / (10 as u64);
        if (x == (0 as u64)) { break; }
    }
    put((&b[i]) as *void, (24 - i) as i64);
}

func put_2digits(v: u32) -> void {
    var b: [char; 2] = uninit;
    b[0] = ((48 as u32) + (v / (10 as u32))) as char;
    b[1] = ((48 as u32) + (v % (10 as u32))) as char;
    put((&b[0]) as *void, 2 as i64);
}

func put_ts(us: i64) -> void {
    var s: i64 = us / (1000000 as i64);
    var r: i64 = us % (1000000 as i64);
    if (r < (0 as i64)) {
        r = r + (1000000 as i64);
        s = s - (1 as i64);
    }
    s = s + (946684800 as i64); // 2000-01-01 -> 1970-01-01
    var days: i64 = s / (86400 as i64);
    var sod: i64 = s % (86400 as i64);
    if (sod < (0 as i64)) {
        sod = sod + (86400 as i64);
        days = days - (1 as i64);
    }
    days = days + (719468 as i64); // civil_from_days (H. Hinnant)
    var era: i64 = 0 as i64;
    if (days >= (0 as i64)) {
        era = days / (146097 as i64);
    } else {
        era = (days - (146096 as i64)) / (146097 as i64);
    }
    var doe: u32 = (days - era * (146097 as i64)) as u32;
    var yoe: u32 = (doe - doe / (1460 as u32) + doe / (36524 as u32) - doe / (146096 as u32)) / (365 as u32);
    var doy: u32 = doe - ((365 as u32) * yoe + yoe / (4 as u32) - yoe / (100 as u32));
    var mp: u32 = ((5 as u32) * doy + (2 as u32)) / (153 as u32);
    var d: u32 = doy - ((153 as u32) * mp + (2 as u32)) / (5 as u32) + (1 as u32);
    var m: u32 = 0 as u32;
    if (mp < (10 as u32)) {
        m = mp + (3 as u32);
    } else {
        m = mp - (9 as u32);
    }
    var y: i64 = (yoe as i64) + era * (400 as i64);
    if (m <= (2 as u32)) {
        y = y + (1 as i64);
    }

    put_2digits((y / (100 as i64)) as u32);
    put_2digits((y % (100 as i64)) as u32);
    puts_lit("-");
    put_2digits(m);
    puts_lit("-");
    put_2digits(d);
    puts_lit("T");
    put_2digits((sod / (3600 as i64)) as u32);
    puts_lit(":");
    put_2digits(((sod / (60 as i64)) % (60 as i64)) as u32);
    puts_lit(":");
    put_2digits((sod % (60 as i64)) as u32);
    puts_lit(".");
    var ms: u32 = (r / (1000 as i64)) as u32;
    var mb: [char; 4] = uninit;
    mb[0] = ((48 as u32) + (ms / (100 as u32))) as char;
    mb[1] = ((48 as u32) + ((ms / (10 as u32)) % (10 as u32))) as char;
    mb[2] = ((48 as u32) + (ms % (10 as u32))) as char;
    mb[3] = 'Z';
    put((&mb[0]) as *void, 4 as i64);
}

func put_json_str(s: *u8, n: i64) -> void {
    var i: i64 = 0;
    var run: i64 = 0;
    var hex: *char = "0123456789abcdef";
    while (i < n) {
        var c: u8 = *(((s as i64) + (i as i64)) as *u8);
        if (c >= (32 as u8) && c != (34 as u8) && c != (92 as u8)) {
            i = i + (1 as i64);
            continue;
        }
        if (i > run) {
            put((s as i64 + run) as *void, i - run);
        }
        run = i + (1 as i64);
        if (c == (34 as u8)) {
            puts_lit("\\\"");
        } else if (c == (92 as u8)) {
            puts_lit("\\\\");
        } else if (c == (10 as u8)) {
            puts_lit("\\n");
        } else if (c == (13 as u8)) {
            puts_lit("\\r");
        } else if (c == (9 as u8)) {
            puts_lit("\\t");
        } else {
            var eb: [char; 6] = uninit;
            eb[0] = '\\';
            eb[1] = 'u';
            eb[2] = '0';
            eb[3] = '0';
            eb[4] = *(((hex as i64) + ((c >> 4) as i64)) as *char);
            eb[5] = *(((hex as i64) + ((c & (15 as u8)) as i64)) as *char);
            put((&eb[0]) as *void, 6 as i64);
        }
        i = i + (1 as i64);
    }
    if (n > run) {
        put((s as i64 + run) as *void, n - run);
    }
}

func begin_resp(status: int, close_conn: int) -> void {
    g_alen = 0 as i64;
    g_zlen = 0 as u64;
    if (status == 200) {
        puts_lit("HTTP/1.1 200 OK\r\n");
    } else if (status == 201) {
        puts_lit("HTTP/1.1 201 Created\r\n");
    } else if (status == 400) {
        puts_lit("HTTP/1.1 400 Bad Request\r\n");
    } else if (status == 401) {
        puts_lit("HTTP/1.1 401 Unauthorized\r\n");
    } else if (status == 404) {
        puts_lit("HTTP/1.1 404 Not Found\r\n");
    } else if (status == 503) {
        puts_lit("HTTP/1.1 503 Service Unavailable\r\n");
    } else {
        puts_lit("HTTP/1.1 500 Internal Server Error\r\n");
    }
    if (close_conn != 0) {
        puts_lit("Connection: close\r\n");
    }
    puts_lit("Content-Type: application/json\r\nContent-Length:       \r\n\r\n");
    g_cl_pos = g_alen - (10 as i64);
    g_body_start = g_alen;
}

func finish_resp() -> void {
    var n: i64 = g_alen - g_body_start;
    if (g_want_gz != 0 && n >= GZMIN) {
        var comp_len: u64 = libdeflate_gzip_compress(g_deflate_comp, (g_arena as i64 + g_body_start) as *void, n as u64, g_zbuf as *void, ARENA_SIZE as u64);
        if (comp_len > (0 as u64)) {
            g_zlen = comp_len;
            g_alen = g_cl_pos - (16 as i64);
            puts_lit("Content-Encoding: gzip\r\nContent-Length: ");
            put_u64(g_zlen);
            puts_lit("\r\n\r\n");
            return;
        }
    }
    var p: *char = (g_arena as i64 + g_cl_pos + 6 as i64) as *char;
    var x: i64 = n;
    for (;;) {
        p = (p as i64 - 1 as i64) as *char;
        *p = ((48 as i64) + (x % (10 as i64))) as char;
        x = x / (10 as i64);
        if (x == (0 as i64)) { break; }
    }
}

func err_resp(status: int, msg: *char, close_conn: int) -> void {
    begin_resp(status, close_conn);
    puts_lit("{\"error\":\"");
    puts_lit(msg);
    puts_lit("\"}");
    finish_resp();
}

func put_post_row(r: *void, i: int) -> void {
    puts_lit("{\"id\":");
    put_u64(read_be64(PQgetvalue(r, i, 0) as *void) as u64);
    puts_lit(",\"body\":\"");
    put_json_str(PQgetvalue(r, i, 1) as *u8, PQgetlength(r, i, 1) as i64);
    puts_lit("\",\"created_at\":\"");
    put_ts(read_be64(PQgetvalue(r, i, 2) as *void));
    puts_lit("\",\"author\":\"");
    put_json_str(PQgetvalue(r, i, 3) as *u8, PQgetlength(r, i, 3) as i64);
    puts_lit("\",\"like_count\":");
    put_u64(read_be32(PQgetvalue(r, i, 4) as *void) as u64);
    puts_lit("}");
}

func b64url_decode(s: *char, n: i64, out: *u8) -> int {
    if ((n % (4 as i64)) == (1 as i64)) { return -1; }
    var acc: u32 = 0 as u32;
    var bits: int = 0;
    var o: int = 0;
    for (var i: i64 = 0; i < n; i = i + 1 as i64) {
        var c: u8 = *(((s as i64) + (i as i64)) as *u8);
        var v: i8 = g_b64t[c as int];
        if (v < (0 as i8)) { return -1; }
        acc = (acc << 6) | (v as u32);
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            *(out as i64 + (o as i64) as *u8) = (acc >> bits) as u8;
            o = o + 1;
        }
    }
    return o;
}

func hex_digit(c: int) -> int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return -1;
}

func utf8_seq_len(p: *u8, e: *u8) -> int {
    var c: u8 = *p;
    if (c < (0x80 as u8)) { return 1; }
    var rem: i64 = e as i64 - p as i64;
    if (c >= (0xC2 as u8) && c <= (0xDF as u8)) {
        var p1: u8 = *(((p as i64) + (1 as i64)) as *u8);
        if (rem >= (2 as i64) && (p1 & (0xC0 as u8)) == (0x80 as u8)) { return 2; }
        return 0;
    }
    if (c >= (0xE0 as u8) && c <= (0xEF as u8)) {
        var p1: u8 = *(((p as i64) + (1 as i64)) as *u8);
        var p2: u8 = *(((p as i64) + (2 as i64)) as *u8);
        if (rem < (3 as i64) || (p1 & (0xC0 as u8)) != (0x80 as u8) || (p2 & (0xC0 as u8)) != (0x80 as u8)) { return 0; }
        if ((c == (0xE0 as u8) && p1 < (0xA0 as u8)) || (c == (0xED as u8) && p1 > (0x9F as u8))) { return 0; }
        return 3;
    }
    if (c >= (0xF0 as u8) && c <= (0xF4 as u8)) {
        var p1: u8 = *(((p as i64) + (1 as i64)) as *u8);
        var p2: u8 = *(((p as i64) + (2 as i64)) as *u8);
        var p3: u8 = *(((p as i64) + (3 as i64)) as *u8);
        if (rem < (4 as i64) || (p1 & (0xC0 as u8)) != (0x80 as u8) || (p2 & (0xC0 as u8)) != (0x80 as u8) || (p3 & (0xC0 as u8)) != (0x80 as u8)) { return 0; }
        if ((c == (0xF0 as u8) && p1 < (0x90 as u8)) || (c == (0xF4 as u8) && p1 > (0x8F as u8))) { return 0; }
        return 4;
    }
    return 0;
}

func parse_json_str(p_inout: **char, e: *char, out: *char, cap: i64) -> i64 {
    var p: *u8 = (*p_inout as i64 + 1 as i64) as *u8;
    var ep: *u8 = e as *u8;
    var o: i64 = 0;
    var over: int = 0;

    while (p as i64 < ep as i64) {
        var c: u8 = *p;
        if (c == (34 as u8)) { // closing quote
            *p_inout = (p as i64 + 1 as i64) as *char;
            if (over != 0) { return -2 as i64; }
            return o;
        }
        if (c < (32 as u8)) { return -1 as i64; }
        if (c == (92 as u8)) { // backslash
            p = (p as i64 + 1 as i64) as *u8;
            if (p as i64 >= ep as i64) { return -1 as i64; }
            var esc: u8 = *p;
            var ch: u8 = 0 as u8;
            if (esc == (34 as u8)) { ch = 34 as u8; }
            else if (esc == (92 as u8)) { ch = 92 as u8; }
            else if (esc == (47 as u8)) { ch = 47 as u8; }
            else if (esc == (98 as u8)) { ch = 8 as u8; }
            else if (esc == (102 as u8)) { ch = 12 as u8; }
            else if (esc == (110 as u8)) { ch = 10 as u8; }
            else if (esc == (114 as u8)) { ch = 13 as u8; }
            else if (esc == (116 as u8)) { ch = 9 as u8; }
            else if (esc == (117 as u8)) { // \uXXXX
                if ((ep as i64 - p as i64) < (5 as i64)) { return -1 as i64; }
                var a: int = hex_digit(*(((p as i64) + (1 as i64)) as *u8) as int);
                var b: int = hex_digit(*(((p as i64) + (2 as i64)) as *u8) as int);
                var c2: int = hex_digit(*(((p as i64) + (3 as i64)) as *u8) as int);
                var d: int = hex_digit(*(((p as i64) + (4 as i64)) as *u8) as int);
                if ((a | b | c2 | d) < 0) { return -1 as i64; }
                var cp: u32 = ((a as u32) << 12) | ((b as u32) << 8) | ((c2 as u32) << 4) | (d as u32);
                p = (p as i64 + 4 as i64) as *u8;
                // Surrogate pair handling
                if (cp >= (0xD800 as u32) && cp <= (0xDBFF as u32) && (ep as i64 - p as i64) >= (7 as i64)) {
                    var p1_slash: u8 = *(((p as i64) + (1 as i64)) as *u8);
                    var p2_u: u8 = *(((p as i64) + (2 as i64)) as *u8);
                    if (p1_slash == (92 as u8) && p2_u == (117 as u8)) {
                        var a2: int = hex_digit(*(((p as i64) + (3 as i64)) as *u8) as int);
                        var b2: int = hex_digit(*(((p as i64) + (4 as i64)) as *u8) as int);
                        var c3: int = hex_digit(*(((p as i64) + (5 as i64)) as *u8) as int);
                        var d2: int = hex_digit(*(((p as i64) + (6 as i64)) as *u8) as int);
                        if ((a2 | b2 | c3 | d2) >= 0) {
                            var lo: u32 = ((a2 as u32) << 12) | ((b2 as u32) << 8) | ((c3 as u32) << 4) | (d2 as u32);
                            if (lo >= (0xDC00 as u32) && lo <= (0xDFFF as u32)) {
                                cp = (0x10000 as u32) + ((cp - (0xD800 as u32)) << 10) + (lo - (0xDC00 as u32));
                                p = (p as i64 + 6 as i64) as *u8;
                            }
                        }
                    }
                }
                if (cp >= (0xD800 as u32) && cp <= (0xDFFF as u32)) {
                    cp = 0xFFFD as u32;
                }
                var ubuf: [u8; 4] = uninit;
                var ulen: int = 0;
                if (cp < (0x80 as u32)) {
                    ubuf[0] = cp as u8;
                    ulen = 1;
                } else if (cp < (0x800 as u32)) {
                    ubuf[0] = (0xC0 as u32 | (cp >> 6)) as u8;
                    ubuf[1] = (0x80 as u32 | (cp & (63 as u32))) as u8;
                    ulen = 2;
                } else if (cp < (0x10000 as u32)) {
                    ubuf[0] = (0xE0 as u32 | (cp >> 12)) as u8;
                    ubuf[1] = (0x80 as u32 | ((cp >> 6) & (63 as u32))) as u8;
                    ubuf[2] = (0x80 as u32 | (cp & (63 as u32))) as u8;
                    ulen = 3;
                } else {
                    ubuf[0] = (0xF0 as u32 | (cp >> 18)) as u8;
                    ubuf[1] = (0x80 as u32 | ((cp >> 12) & (63 as u32))) as u8;
                    ubuf[2] = (0x80 as u32 | ((cp >> 6) & (63 as u32))) as u8;
                    ubuf[3] = (0x80 as u32 | (cp & (63 as u32))) as u8;
                    ulen = 4;
                }
                if (out as i64 != 0 as i64) {
                    if (o + (ulen as i64) <= cap) {
                        memcpy((out as i64 + o) as *void, (&ubuf[0]) as *void, ulen as i64);
                    } else {
                        over = 1;
                    }
                }
                o = o + (ulen as i64);
                p = (p as i64 + 1 as i64) as *u8;
                continue;
            } else {
                return -1 as i64;
            }

            if (out as i64 != 0 as i64) {
                if (o < cap) {
                    *(((out as i64) + (o as i64)) as *u8) = ch;
                } else {
                    over = 1;
                }
            }
            o = o + (1 as i64);
            p = (p as i64 + 1 as i64) as *u8;
            continue;
        }

        var l: int = utf8_seq_len(p, ep);
        if (l == 0) { return -1 as i64; }
        if (out as i64 != 0 as i64) {
            if (o + (l as i64) <= cap) {
                memcpy((out as i64 + o) as *void, p as *void, l as i64);
            } else {
                over = 1;
            }
        }
        o = o + (l as i64);
        p = (p as i64 + l as i64) as *u8;
    }
    return -1 as i64;
}

func skip_ws(p_inout: **char, e: *char) -> void {
    var p: *char = *p_inout;
    while (p as i64 < e as i64) {
        var c: char = *p;
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
            p = (p as i64 + 1 as i64) as *char;
        } else {
            break;
        }
    }
    *p_inout = p;
}

func skip_json_number(p_inout: **char, e: *char) -> int {
    var p: *char = *p_inout;
    if (p as i64 < e as i64 && *p == '-') {
        p = (p as i64 + 1 as i64) as *char;
    }
    if (p as i64 >= e as i64) { return 0; }
    if (*p == '0') {
        p = (p as i64 + 1 as i64) as *char;
    } else if (*p >= '1' && *p <= '9') {
        while (p as i64 < e as i64 && *p >= '0' && *p <= '9') {
            p = (p as i64 + 1 as i64) as *char;
        }
    } else {
        return 0;
    }
    if (p as i64 < e as i64 && *p == '.') {
        p = (p as i64 + 1 as i64) as *char;
        if (p as i64 >= e as i64 || *p < '0' || *p > '9') { return 0; }
        while (p as i64 < e as i64 && *p >= '0' && *p <= '9') {
            p = (p as i64 + 1 as i64) as *char;
        }
    }
    if (p as i64 < e as i64 && (*p == 'e' || *p == 'E')) {
        p = (p as i64 + 1 as i64) as *char;
        if (p as i64 < e as i64 && (*p == '+' || *p == '-')) {
            p = (p as i64 + 1 as i64) as *char;
        }
        if (p as i64 >= e as i64 || *p < '0' || *p > '9') { return 0; }
        while (p as i64 < e as i64 && *p >= '0' && *p <= '9') {
            p = (p as i64 + 1 as i64) as *char;
        }
    }
    *p_inout = p;
    return 1;
}

func skip_json_lit(p_inout: **char, e: *char, lit: *char, n: i64) -> int {
    var p: *char = *p_inout;
    if ((e as i64 - p as i64) < n) { return 0; }
    if (strncmp(p, lit, n) != 0) { return 0; }
    *p_inout = (p as i64 + n) as *char;
    return 1;
}

func skip_json_val(p_inout: **char, e: *char, depth: int) -> int {
    if (depth > 64) { return 0; }
    skip_ws(p_inout, e);
    var p: *char = *p_inout;
    if (p as i64 >= e as i64) { return 0; }
    var c: char = *p;
    if (c == '"') {
        var len: i64 = parse_json_str(p_inout, e, 0 as *char, 0 as i64);
        return (len >= (0 as i64)) ? 1 : 0;
    }
    if (c == '{') {
        *p_inout = (p as i64 + 1 as i64) as *char;
        skip_ws(p_inout, e);
        if (*p_inout as i64 < e as i64 && **p_inout == '}') {
            *p_inout = (*p_inout as i64 + 1 as i64) as *char;
            return 1;
        }
        for (;;) {
            skip_ws(p_inout, e);
            if (*p_inout as i64 >= e as i64 || **p_inout != '"') { return 0; }
            if (parse_json_str(p_inout, e, 0 as *char, 0 as i64) < (0 as i64)) { return 0; }
            skip_ws(p_inout, e);
            if (*p_inout as i64 >= e as i64 || **p_inout != ':') { return 0; }
            *p_inout = (*p_inout as i64 + 1 as i64) as *char;
            if (skip_json_val(p_inout, e, depth + 1) == 0) { return 0; }
            skip_ws(p_inout, e);
            if (*p_inout as i64 >= e as i64) { return 0; }
            if (**p_inout == ',') {
                *p_inout = (*p_inout as i64 + 1 as i64) as *char;
                continue;
            }
            if (**p_inout == '}') {
                *p_inout = (*p_inout as i64 + 1 as i64) as *char;
                return 1;
            }
            return 0;
        }
    }
    if (c == '[') {
        *p_inout = (p as i64 + 1 as i64) as *char;
        skip_ws(p_inout, e);
        if (*p_inout as i64 < e as i64 && **p_inout == ']') {
            *p_inout = (*p_inout as i64 + 1 as i64) as *char;
            return 1;
        }
        for (;;) {
            if (skip_json_val(p_inout, e, depth + 1) == 0) { return 0; }
            skip_ws(p_inout, e);
            if (*p_inout as i64 >= e as i64) { return 0; }
            if (**p_inout == ',') {
                *p_inout = (*p_inout as i64 + 1 as i64) as *char;
                continue;
            }
            if (**p_inout == ']') {
                *p_inout = (*p_inout as i64 + 1 as i64) as *char;
                return 1;
            }
            return 0;
        }
    }
    if (c == 't') { return skip_json_lit(p_inout, e, "true", 4 as i64); }
    if (c == 'f') { return skip_json_lit(p_inout, e, "false", 5 as i64); }
    if (c == 'n') { return skip_json_lit(p_inout, e, "null", 4 as i64); }
    return skip_json_number(p_inout, e);
}

func jsws_at(p: *u8, e: *u8) -> int {
    var c: u8 = *p;
    if (c == (32 as u8) || (c >= (9 as u8) && c <= (13 as u8))) { return 1; }
    var rem: i64 = e as i64 - p as i64;
    if (rem >= (2 as i64) && *p == (0xC2 as u8) && *(((p as i64) + (1 as i64)) as *u8) == (0xA0 as u8)) { return 2; }
    if (rem >= (3 as i64)) {
        var cp: u32 = ((*p as u32) << 16) | ((*(((p as i64) + (1 as i64)) as *u8) as u32) << 8) | (*(((p as i64) + (2 as i64)) as *u8) as u32);
        if (cp == (0xE19A80 as u32) || (cp >= (0xE28080 as u32) && cp <= (0xE2808A as u32)) ||
            cp == (0xE280A8 as u32) || cp == (0xE280A9 as u32) || cp == (0xE280AF as u32) ||
            cp == (0xE2819F as u32) || cp == (0xE38080 as u32) || cp == (0xEFBBBF as u32)) {
            return 3;
        }
    }
    return 0;
}

func jsws_before(s: *u8, e: *u8) -> int {
    var rem: i64 = e as i64 - s as i64;
    if (rem <= (0 as i64)) { return 0; }
    var last: u8 = *(((e as i64) - (1 as i64)) as *u8);
    if (last == (32 as u8) || (last >= (9 as u8) && last <= (13 as u8))) { return 1; }
    if (rem >= (2 as i64)) {
        var p2_0: u8 = *(((e as i64) - (2 as i64)) as *u8);
        var p2_1: u8 = *(((e as i64) - (1 as i64)) as *u8);
        if (p2_0 == (0xC2 as u8) && p2_1 == (0xA0 as u8)) { return 2; }
    }
    if (rem >= (3 as i64)) {
        var p3: *u8 = (e as i64 - 3 as i64) as *u8;
        if (jsws_at(p3, e) == 3) { return 3; }
    }
    return 0;
}

func verify_auth(h: *char, hl: i64, uid_out: *i64, uname_out: *char, unl_out: *i64) -> *char {
    var err_missing: *char = "missing bearer token";
    var err_bad: *char = "invalid or expired token";
    var err_payload: *char = "invalid token payload";

    if (h as i64 == 0 as i64 || hl < (7 as i64) || strncmp(h, "Bearer ", 7 as i64) != 0) {
        return err_missing;
    }
    var t: *char = (h as i64 + 7 as i64) as *char;
    var tl: i64 = hl - (7 as i64);
    var d1: *char = memchr(t as *void, '.' as int, tl) as *char;
    if (d1 as i64 == 0 as i64) { return err_bad; }
    var rem1: i64 = (t as i64 + tl) - (d1 as i64 + 1 as i64);
    var d2: *char = memchr((d1 as i64 + 1 as i64) as *void, '.' as int, rem1) as *char;
    if (d2 as i64 == 0 as i64) { return err_bad; }
    var rem2: i64 = (t as i64 + tl) - (d2 as i64 + 1 as i64);
    if (memchr((d2 as i64 + 1 as i64) as *void, '.' as int, rem2) as i64 != (0 as i64)) { return err_bad; }

    var sig_str: *char = (d2 as i64 + 1 as i64) as *char;
    var sig_str_len: i64 = rem2;
    if (sig_str_len != (43 as i64)) { return err_bad; }

    var sig_decoded: [u8; 48] = uninit;
    var sig_len: int = b64url_decode(sig_str, sig_str_len, &sig_decoded[0]);
    if (sig_len != 32) { return err_bad; }

    var signed_data_len: i64 = d2 as i64 - t as i64;
    var mac: [u8; 48] = uninit;
    var mac_len: u32 = 0 as u32;
    HMAC(EVP_sha256(), g_jwt_secret as *void, g_jwt_secret_len, t as *void, signed_data_len, (&mac[0]) as *void, &mac_len);
    if (mac_len != (32 as u32)) { return err_bad; }
    if (CRYPTO_memcmp((&sig_decoded[0]) as *void, (&mac[0]) as *void, 32 as i64) != 0) {
        return err_bad;
    }

    var hdr_str: *char = t;
    var hdr_str_len: i64 = d1 as i64 - t as i64;
    if (hdr_str_len > (680 as i64)) { return err_bad; }
    var hdr_decoded: [u8; 512] = uninit;
    var hdr_len: int = b64url_decode(hdr_str, hdr_str_len, &hdr_decoded[0]);
    if (hdr_len < 0) { return err_bad; }

    var hj: *char = (&hdr_decoded[0]) as *char;
    var he: *char = (hj as i64 + hdr_len as i64) as *char;
    skip_ws(&hj, he);
    if (hj as i64 >= he as i64 || *hj != '{') { return err_bad; }
    hj = (hj as i64 + 1 as i64) as *char;
    var found_alg: int = 0;
    for (;;) {
        skip_ws(&hj, he);
        if (hj as i64 >= he as i64) { return err_bad; }
        if (*hj == '}') { break; }
        var kbuf: [char; 32] = uninit;
        var kl: i64 = parse_json_str(&hj, he, &kbuf[0], 31 as i64);
        if (kl < (0 as i64)) { return err_bad; }
        kbuf[kl as int] = 0 as char;
        skip_ws(&hj, he);
        if (hj as i64 >= he as i64 || *hj != ':') { return err_bad; }
        hj = (hj as i64 + 1 as i64) as *char;
        skip_ws(&hj, he);
        if (strcmp(&kbuf[0], "alg") == 0) {
            if (hj as i64 >= he as i64 || *hj != '"') { return err_bad; }
            var abuf: [char; 16] = uninit;
            var al: i64 = parse_json_str(&hj, he, &abuf[0], 15 as i64);
            if (al == (5 as i64) && strncmp(&abuf[0], "HS256", 5 as i64) == 0) {
                found_alg = 1;
            } else {
                return err_bad;
            }
        } else {
            if (skip_json_val(&hj, he, 1) == 0) { return err_bad; }
        }
        skip_ws(&hj, he);
        if (hj as i64 < he as i64 && *hj == ',') {
            hj = (hj as i64 + 1 as i64) as *char;
            continue;
        }
        if (hj as i64 < he as i64 && *hj == '}') {
            break;
        }
        return err_bad;
    }
    if (found_alg == 0) { return err_bad; }

    var pl_str: *char = (d1 as i64 + 1 as i64) as *char;
    var pl_str_len: i64 = d2 as i64 - (d1 as i64 + 1 as i64);
    if (pl_str_len > (2700 as i64)) { return err_bad; }
    var pl_decoded: [u8; 2048] = uninit;
    var pl_len: int = b64url_decode(pl_str, pl_str_len, &pl_decoded[0]);
    if (pl_len < 0) { return err_bad; }

    var pj: *char = (&pl_decoded[0]) as *char;
    var pe: *char = (pj as i64 + pl_len as i64) as *char;
    skip_ws(&pj, pe);
    if (pj as i64 >= pe as i64 || *pj != '{') { return err_bad; }
    pj = (pj as i64 + 1 as i64) as *char;

    var has_exp: int = 0;
    var has_sub: int = 0;
    var has_user: int = 0;
    var sub_val: i64 = 0 as i64;
    var user_len: i64 = 0 as i64;

    for (;;) {
        skip_ws(&pj, pe);
        if (pj as i64 >= pe as i64) { return err_bad; }
        if (*pj == '}') { break; }
        var kbuf: [char; 32] = uninit;
        var kl: i64 = parse_json_str(&pj, pe, &kbuf[0], 31 as i64);
        if (kl < (0 as i64)) { return err_bad; }
        kbuf[kl as int] = 0 as char;
        skip_ws(&pj, pe);
        if (pj as i64 >= pe as i64 || *pj != ':') { return err_bad; }
        pj = (pj as i64 + 1 as i64) as *char;
        skip_ws(&pj, pe);

        if (strcmp(&kbuf[0], "exp") == 0) {
            var vs: *char = pj;
            if (skip_json_number(&pj, pe) == 0) { return err_bad; }
            has_exp = 1;
            var exp_s: i64 = 0 as i64;
            var neg: int = 0;
            if (*vs == '-') { neg = 1; vs = (vs as i64 + 1 as i64) as *char; }
            while (vs as i64 < pj as i64 && *vs >= '0' && *vs <= '9') {
                exp_s = exp_s * (10 as i64) + ((*vs as i64) - (48 as i64));
                vs = (vs as i64 + 1 as i64) as *char;
            }
            if (neg != 0) { exp_s = 0 as i64 - exp_s; }
            if (g_now_s >= exp_s) { return err_bad; }
        } else if (strcmp(&kbuf[0], "nbf") == 0) {
            var vs: *char = pj;
            if (skip_json_number(&pj, pe) == 0) { return err_bad; }
            var nbf_s: i64 = 0 as i64;
            var neg: int = 0;
            if (*vs == '-') { neg = 1; vs = (vs as i64 + 1 as i64) as *char; }
            while (vs as i64 < pj as i64 && *vs >= '0' && *vs <= '9') {
                nbf_s = nbf_s * (10 as i64) + ((*vs as i64) - (48 as i64));
                vs = (vs as i64 + 1 as i64) as *char;
            }
            if (neg != 0) { nbf_s = 0 as i64 - nbf_s; }
            if (g_now_s < nbf_s) { return err_bad; }
        } else if (strcmp(&kbuf[0], "sub") == 0) {
            if (pj as i64 >= pe as i64 || *pj != '"') { return err_payload; }
            var sbuf: [char; 32] = uninit;
            var sl: i64 = parse_json_str(&pj, pe, &sbuf[0], 31 as i64);
            if (sl <= (0 as i64) || sl > (15 as i64)) { return err_payload; }
            sub_val = 0 as i64;
            for (var si: i64 = 0; si < sl; si = si + 1 as i64) {
                var sc: char = sbuf[si as int];
                if (sc < '0' || sc > '9') { return err_payload; }
                sub_val = sub_val * (10 as i64) + ((sc as i64) - (48 as i64));
            }
            if (sub_val <= (0 as i64)) { return err_payload; }
            has_sub = 1;
        } else if (strcmp(&kbuf[0], "username") == 0) {
            if (pj as i64 >= pe as i64 || *pj != '"') { return err_payload; }
            user_len = parse_json_str(&pj, pe, uname_out, 1023 as i64);
            if (user_len < (0 as i64)) { return err_payload; }
            uname_out[user_len as int] = 0 as char;
            has_user = 1;
        } else {
            if (skip_json_val(&pj, pe, 1) == 0) { return err_bad; }
        }

        skip_ws(&pj, pe);
        if (pj as i64 < pe as i64 && *pj == ',') {
            pj = (pj as i64 + 1 as i64) as *char;
            continue;
        }
        if (pj as i64 < pe as i64 && *pj == '}') {
            break;
        }
        return err_bad;
    }

    if (has_exp == 0) { return err_bad; }
    if (has_sub == 0 || has_user == 0) { return err_payload; }

    *uid_out = sub_val;
    *unl_out = user_len;
    return 0 as *char;
}

func pg_connect(idx: int) -> int {
    var p: *PgConn = (g_pg as i64 + (idx as i64) * (sizeof(PgConn) as i64)) as *PgConn;
    var kw: [*char; 3] = uninit;
    kw[0] = "dbname";
    kw[1] = "connect_timeout";
    kw[2] = 0 as *char;

    var val: [*char; 3] = uninit;
    val[0] = g_dburl;
    val[1] = "3";
    val[2] = 0 as *char;

    var c: *void = PQconnectdbParams((&kw[0]) as **char, (&val[0]) as **char, 1);
    if (PQstatus(c) != CONNECTION_OK) {
        fprintf(0 as *void, PQerrorMessage(c));
        PQfinish(c);
        return 0;
    }

    var i8_types: [u32; 2] = uninit;
    i8_types[0] = 20 as u32; // INT8OID
    i8_types[1] = 20 as u32;

    var i8t_types: [u32; 2] = uninit;
    i8t_types[0] = 20 as u32;
    i8t_types[1] = 25 as u32; // TEXTOID

    var sql_f: *char = "SELECT p.id, p.body, p.created_at, u.username, (SELECT count(*) FROM likes l WHERE l.post_id = p.id)::int AS like_count FROM posts p JOIN users u ON u.id = p.user_id ORDER BY p.created_at DESC, p.id DESC LIMIT 20";
    var sql_p: *char = "SELECT p.id, p.body, p.created_at, u.username, (SELECT count(*) FROM likes l WHERE l.post_id = p.id)::int AS like_count FROM posts p JOIN users u ON u.id = p.user_id WHERE p.id = $1";
    var sql_i: *char = "INSERT INTO posts (user_id, body) VALUES ($1, $2) RETURNING id, created_at";
    var sql_l: *char = "INSERT INTO likes (user_id, post_id) VALUES ($1, $2) ON CONFLICT (user_id, post_id) DO NOTHING";
    var sql_h: *char = "SELECT 1";

    var r: *void = PQprepare(c, "f", sql_f, 0, 0 as *u32);
    var ok: int = (PQresultStatus(r) == PGRES_COMMAND_OK) ? 1 : 0;
    PQclear(r);
    if (ok == 0) { PQfinish(c); return 0; }

    r = PQprepare(c, "p", sql_p, 1, (&i8_types[0]));
    ok = (PQresultStatus(r) == PGRES_COMMAND_OK) ? 1 : 0;
    PQclear(r);
    if (ok == 0) { PQfinish(c); return 0; }

    r = PQprepare(c, "i", sql_i, 2, (&i8t_types[0]));
    ok = (PQresultStatus(r) == PGRES_COMMAND_OK) ? 1 : 0;
    PQclear(r);
    if (ok == 0) { PQfinish(c); return 0; }

    r = PQprepare(c, "l", sql_l, 2, (&i8_types[0]));
    ok = (PQresultStatus(r) == PGRES_COMMAND_OK) ? 1 : 0;
    PQclear(r);
    if (ok == 0) { PQfinish(c); return 0; }

    r = PQprepare(c, "h", sql_h, 0, 0 as *u32);
    ok = (PQresultStatus(r) == PGRES_COMMAND_OK) ? 1 : 0;
    PQclear(r);
    if (ok == 0) { PQfinish(c); return 0; }

    if (PQenterPipelineMode(c) == 0 || PQsetnonblocking(c, 1) != 0) {
        PQfinish(c);
        return 0;
    }

    p->c = c;
    p->sock = PQsocket(c);
    ep_set(g_ep, EPOLL_CTL_ADD, p->sock, TAG_PG_BASE | (idx as u64), EPOLLIN);
    return 1;
}

func qpush(p: *PgConn) -> *QueryItem {
    if (p->q_n == p->q_cap) {
        var nc: u32 = (p->q_cap != (0 as u32)) ? (p->q_cap * (2 as u32)) : (256 as u32);
        var nq: *QueryItem = malloc((nc as i64) * (sizeof(QueryItem) as i64)) as *QueryItem;
        for (var k: u32 = 0 as u32; k < p->q_n; k = k + 1 as u32) {
            var src: *QueryItem = (p->q_buf as i64 + (((p->q_head + k) & (p->q_cap - (1 as u32))) as i64) * (sizeof(QueryItem) as i64)) as *QueryItem;
            var dst: *QueryItem = (nq as i64 + (k as i64) * (sizeof(QueryItem) as i64)) as *QueryItem;
            *dst = *src;
        }
        if (p->q_buf as i64 != 0 as i64) {
            free(p->q_buf as *void);
        }
        p->q_buf = nq;
        p->q_cap = nc;
        p->q_head = 0 as u32;
    }
    var idx: u32 = (p->q_head + p->q_n) & (p->q_cap - (1 as u32));
    p->q_n = p->q_n + (1 as u32);
    return (p->q_buf as i64 + (idx as i64) * (sizeof(QueryItem) as i64)) as *QueryItem;
}

func conn_close(fd: int) -> void {
    var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
    if (c->in_buf as i64 != 0 as i64) { free(c->in_buf as *void); }
    if (c->out_buf as i64 != 0 as i64) { free(c->out_buf as *void); }
    var g: u32 = c->gen + (1 as u32);
    memset(c as *void, 0, sizeof(Connection) as i64);
    c->gen = g;
    close(fd);
}

func send_resp(fd: int, close_conn: int) -> void {
    var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
    var iv: [IoVec; 2] = uninit;
    iv[0].iov_base = g_arena as *void;
    iv[0].iov_len = g_alen as u64;
    iv[1].iov_base = g_zbuf as *void;
    iv[1].iov_len = g_zlen;
    var total: i64 = g_alen + (g_zlen as i64);
    var w: i64 = writev(fd, (&iv[0]) as *void, g_zlen > (0 as u64) ? 2 : 1);
    if (w < (0 as i64)) {
        w = 0 as i64;
    }
    if (close_conn != 0) {
        c->closing = 1 as u8;
    }
    if (w < total) {
        c->out_len = (total - w) as u32;
        c->out_off = 0 as u32;
        c->out_buf = malloc(c->out_len as i64) as *char;
        if (w < g_alen) {
            memcpy(c->out_buf as *void, (g_arena as i64 + w) as *void, g_alen - w);
            if (g_zlen > (0 as u64)) {
                memcpy((c->out_buf as i64 + (g_alen - w)) as *void, g_zbuf as *void, g_zlen as i64);
            }
        } else {
            memcpy(c->out_buf as *void, (g_zbuf as i64 + (w - g_alen)) as *void, c->out_len as i64);
        }
        ep_set(g_ep, EPOLL_CTL_MOD, fd, fd as u64, EPOLLOUT);
    } else if (close_conn != 0) {
        conn_close(fd);
    }
}


func respond(q: *QueryItem, res: *void, fail: int) -> void {
    var fd: int = q->fd;
    var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
    if (q->gen != c->gen || c->open == (0 as u8)) {
        if (q->extra as i64 != 0 as i64) { free(q->extra as *void); }
        return;
    }
    var close_conn: int = q->close_conn as int;
    g_want_gz = q->want_gz as int;

    if (fail != 0) {
        err_resp(500, "internal server error", close_conn);
    } else if (q->kind == Q_FEED) {
        if (res as i64 == 0 as i64 || PQresultStatus(res) != PGRES_TUPLES_OK || PQnfields(res) != 5) {
            err_resp(500, "internal server error", close_conn);
        } else {
            begin_resp(200, close_conn);
            puts_lit("{\"posts\":[");
            var num_rows: int = PQntuples(res);
            for (var i: int = 0; i < num_rows; i = i + 1) {
                if (i > 0) { puts_lit(","); }
                put_post_row(res, i);
            }
            puts_lit("]}");
            finish_resp();
        }
    } else if (q->kind == Q_POST) {
        if (res as i64 == 0 as i64 || PQresultStatus(res) != PGRES_TUPLES_OK || PQnfields(res) != 5) {
            err_resp(500, "internal server error", close_conn);
        } else if (PQntuples(res) == 0) {
            err_resp(404, "post not found", close_conn);
        } else {
            begin_resp(200, close_conn);
            puts_lit("{\"post\":");
            put_post_row(res, 0);
            puts_lit("}");
            finish_resp();
        }
    } else if (q->kind == Q_INS) {
        if (res as i64 == 0 as i64 || PQresultStatus(res) != PGRES_TUPLES_OK || PQnfields(res) != 2 || PQntuples(res) != 1) {
            err_resp(500, "internal server error", close_conn);
        } else {
            begin_resp(201, close_conn);
            puts_lit("{\"post\":{\"id\":");
            put_u64(read_be64(PQgetvalue(res, 0, 0) as *void) as u64);
            puts_lit(",\"body\":\"");
            put_json_str(q->extra as *u8, q->blen as i64);
            puts_lit("\",\"created_at\":\"");
            put_ts(read_be64(PQgetvalue(res, 0, 1) as *void));
            puts_lit("\",\"author\":\"");
            put_json_str((q->extra as i64 + q->blen as i64) as *u8, q->ulen as i64);
            puts_lit("\",\"like_count\":0}");
            puts_lit("}");
            finish_resp();
        }
    } else if (q->kind == Q_LIKE) {
        var s: int = (res as i64 != 0 as i64) ? PQresultStatus(res) : PGRES_FATAL_ERROR;
        if (s == PGRES_COMMAND_OK) {
            var created: int = (strcmp(PQcmdTuples(res), "1") == 0) ? 1 : 0;
            begin_resp((created != 0) ? 201 : 200, close_conn);
            puts_lit("{\"liked\":true,\"already_liked\":");
            if (created != 0) { puts_lit("false"); } else { puts_lit("true"); }
            puts_lit(",\"post_id\":");
            put_u64(q->id as u64);
            puts_lit("}");
            finish_resp();
        } else {
            var st: *char = nilPtr;
            if (res as i64 != 0 as i64) {
                st = PQresultErrorField(res, PG_DIAG_SQLSTATE);
            }
            if (st as i64 != 0 as i64 && strcmp(st, "23503") == 0) {
                err_resp(404, "post not found", close_conn);
            } else {
                err_resp(500, "internal server error", close_conn);
            }
        }
    } else if (q->kind == Q_HEALTH) {
        var s: int = (res as i64 != 0 as i64) ? PQresultStatus(res) : PGRES_FATAL_ERROR;
        if (s == PGRES_TUPLES_OK) {
            begin_resp(200, close_conn);
            puts_lit("{\"status\":\"ok\",\"db\":\"ok\",\"uptime_s\":");
            put_u64((g_now_s - g_started) as u64);
            puts_lit("}");
            finish_resp();
        } else {
            var m: *char = "connection lost";
            if (res as i64 != 0 as i64) {
                m = PQresultErrorMessage(res);
            }
            begin_resp(503, close_conn);
            puts_lit("{\"status\":\"degraded\",\"db\":\"unreachable\",\"error\":\"");
            put_json_str(m as *u8, strlen(m));
            puts_lit("\"}");
            finish_resp();
        }
    }

    if (q->extra as i64 != 0 as i64) {
        free(q->extra as *void);
    }
    c->busy = 0 as u8;
    send_resp(fd, close_conn);
    if (c->open != (0 as u8) && c->out_buf as i64 == 0 as i64 && c->closing == (0 as u8) && c->in_len > (0 as u32)) {
        process_client(g_ep, fd, c->in_buf, c->in_len as i64);
    }
}

func pg_fail(p: *PgConn) -> void {
    epoll_ctl(g_ep, EPOLL_CTL_DEL, p->sock, 0 as *void);
    PQfinish(p->c);
    p->c = 0 as *void;
    if (p->has_held != (0 as u8)) {
        p->has_held = 0 as u8;
        PQclear(p->hres);
        respond(&p->held, 0 as *void, 1);
    }
    while (p->q_n > (0 as u32)) {
        var q: *QueryItem = (p->q_buf as i64 + (p->q_head as i64) * (sizeof(QueryItem) as i64)) as *QueryItem;
        p->q_head = (p->q_head + (1 as u32)) & (p->q_cap - (1 as u32));
        p->q_n = p->q_n - (1 as u32);
        if (q->kind != Q_SYNC) {
            respond(q, 0 as *void, 1);
        }
    }
    p->got = 0 as u8;
    p->unsynced = 0 as u8;
    p->dirty = 0 as u8;
    p->wout = 0 as u8;
}

func pg_sync(p: *PgConn) -> void {
    if (PQsendPipelineSync(p->c) == 0) { return; }
    var q: *QueryItem = qpush(p);
    memset(q as *void, 0, sizeof(QueryItem) as i64);
    q->kind = Q_SYNC;
    p->unsynced = 0 as u8;
}

func pg_flush(p: *PgConn, idx: int) -> void {
    var r: int = PQflush(p->c);
    if (r < 0) {
        pg_fail(p);
        return;
    }
    if ((r as u8) != p->wout) {
        p->wout = r as u8;
        var ev: u32 = EPOLLIN | (r != 0 ? EPOLLOUT : (0 as u32));
        ep_set(g_ep, EPOLL_CTL_MOD, p->sock, TAG_PG_BASE | (idx as u64), ev);
    }
}

func pg_read(p: *PgConn) -> void {
    if (PQconsumeInput(p->c) == 0) {
        pg_fail(p);
        return;
    }
    while (p->c as i64 != 0 as i64 && p->q_n > (0 as u32) && PQisBusy(p->c) == 0) {
        var q: *QueryItem = (p->q_buf as i64 + (p->q_head as i64) * (sizeof(QueryItem) as i64)) as *QueryItem;
        var r: *void = PQgetResult(p->c);
        if (q->kind == Q_SYNC) {
            if (r as i64 == 0 as i64) { break; }
            if (PQresultStatus(r) != PGRES_PIPELINE_SYNC) {
                p->held_fail = 1 as u8;
                PQclear(r);
                continue;
            }
            PQclear(r);
            p->q_head = (p->q_head + (1 as u32)) & (p->q_cap - (1 as u32));
            p->q_n = p->q_n - (1 as u32);
            if (p->has_held != (0 as u8)) {
                var h: QueryItem = uninit;
                memcpy((&h) as *void, (&p->held) as *void, sizeof(QueryItem) as i64);
                var hr: *void = p->hres;
                var f: int = p->held_fail as int;
                p->has_held = 0 as u8;
                p->held_fail = 0 as u8;
                respond(&h, hr, f);
                PQclear(hr);
            }
            continue;
        }

        if (p->got != (0 as u8)) {
            if (r as i64 != 0 as i64) {
                PQclear(r);
                continue;
            }
            p->got = 0 as u8;
            p->q_head = (p->q_head + (1 as u32)) & (p->q_cap - (1 as u32));
            p->q_n = p->q_n - (1 as u32);
            continue;
        }

        p->got = 1 as u8;
        var cq: QueryItem = uninit;
        memcpy((&cq) as *void, q as *void, sizeof(QueryItem) as i64);
        if (cq.kind == Q_INS || cq.kind == Q_LIKE) {
            memcpy((&p->held) as *void, (&cq) as *void, sizeof(QueryItem) as i64);
            p->hres = r;
            p->has_held = 1 as u8;
            p->held_fail = 0 as u8;
            continue;
        }
        respond(&cq, r, (r as i64 == 0 as i64) ? 1 : 0);
        PQclear(r);
    }
}

func pick_conn(is_write: int) -> *PgConn {
    var nw: int = g_npg / 4;
    if (nw < 1) { nw = 1; }
    var b: *PgConn = 0 as *PgConn;
    for (var i: int = 0; i < g_npg; i = i + 1) {
        var p: *PgConn = (g_pg as i64 + (i as i64) * (sizeof(PgConn) as i64)) as *PgConn;
        if (p->c as i64 == 0 as i64 && g_retry_at != g_now_s) {
            g_retry_at = g_now_s;
            pg_connect(i);
        }
        if (p->c as i64 != 0 as i64) {
            var conn_is_write: int = (i >= (g_npg - nw)) ? 1 : 0;
            if (conn_is_write == is_write) {
                if (is_write == 0 && p->dirty != (0 as u8) && p->inbatch < (64 as u16)) {
                    return p;
                }
                if (b as i64 == 0 as i64 || p->q_n < b->q_n) {
                    b = p;
                }
            }
        }
    }
    return b;
}

func enqueue_query(fd: int, kind: u8, close_conn: int, id: i64, uid: i64, s: *char, sl: i64, un: *char, unl: i64) -> int {
    var is_write: int = (kind == Q_INS || kind == Q_LIKE) ? 1 : 0;
    var p: *PgConn = pick_conn(is_write);
    if (p as i64 == 0 as i64) { return 0; }

    var a: u64 = bswap64(uid as u64);
    var b: u64 = bswap64(id as u64);
    var v: [*char; 2] = uninit;
    var len: [int; 2] = uninit;
    len[0] = 8;
    len[1] = 8;
    var fmt: [int; 2] = uninit;
    fmt[0] = 1;
    fmt[1] = 1;
    var ok: int = 0;

    if (kind == Q_FEED) {
        ok = PQsendQueryPrepared(p->c, "f", 0, 0 as **char, 0 as *int, 0 as *int, 1);
    } else if (kind == Q_HEALTH) {
        ok = PQsendQueryPrepared(p->c, "h", 0, 0 as **char, 0 as *int, 0 as *int, 1);
    } else if (kind == Q_POST) {
        v[0] = (&b) as *char;
        ok = PQsendQueryPrepared(p->c, "p", 1, (&v[0]), (&len[0]), (&fmt[0]), 1);
    } else if (kind == Q_LIKE) {
        v[0] = (&a) as *char;
        v[1] = (&b) as *char;
        ok = PQsendQueryPrepared(p->c, "l", 2, (&v[0]), (&len[0]), (&fmt[0]), 1);
    } else { // Q_INS
        v[0] = (&a) as *char;
        v[1] = s;
        len[1] = sl as int;
        ok = PQsendQueryPrepared(p->c, "i", 2, (&v[0]), (&len[0]), (&fmt[0]), 1);
    }
    if (ok == 0) { return 0; }

    var q: *QueryItem = qpush(p);
    var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
    q->fd = fd;
    q->gen = c->gen;
    q->kind = kind;
    q->close_conn = close_conn as u8;
    q->want_gz = g_want_gz as u8;
    q->id = id;
    q->extra = 0 as *char;
    q->blen = 0 as u32;
    q->ulen = 0 as u32;

    if (kind == Q_INS) {
        q->extra = malloc(sl + unl + 1 as i64) as *char;
        memcpy(q->extra as *void, s as *void, sl);
        memcpy((q->extra as i64 + sl) as *void, un as *void, unl);
        q->blen = sl as u32;
        q->ulen = unl as u32;
    }

    p->dirty = 1 as u8;
    p->unsynced = 1 as u8;
    p->inbatch = p->inbatch + (1 as u16);
    if (kind == Q_INS || kind == Q_LIKE) {
        pg_sync(p);
    }
    return 1;
}

func parse_positive_id(s: *char, n: i64) -> i64 {
    if (n <= (0 as i64)) { return -1 as i64; }
    var v: i64 = 0 as i64;
    for (var i: i64 = 0; i < n; i = i + 1 as i64) {
        var c: char = *(((s as i64) + (i as i64)) as *char);
        if (c < '0' || c > '9') { return -1 as i64; }
        if (v < (100000000000000000 as i64)) {
            v = v * (10 as i64) + ((c as i64) - (48 as i64));
        } else {
            v = 0x7FFFFFFFFFFFFFFF as i64;
        }
    }
    return (v > (0 as i64)) ? v : (-1 as i64);
}

func handle_request(fd: int, m: *char, ml: i64, path: *char, pl_in: i64, authh: *char, al: i64, body: *char, bl: i64, close_conn: int) -> void {
    var pl: i64 = pl_in;
    var qmark: *void = memchr(path as *void, '?' as int, pl);
    if (qmark as i64 != 0 as i64) {
        pl = qmark as i64 - path as i64;
    }
    var get: int = (ml == (3 as i64) && strncmp(m, "GET", 3 as i64) == 0) ? 1 : 0;
    var post: int = (ml == (4 as i64) && strncmp(m, "POST", 4 as i64) == 0) ? 1 : 0;
    var kind: u8 = 255 as u8;
    var id: i64 = 0 as i64;
    var uid: i64 = 0 as i64;
    var uname: [char; 1024] = uninit;
    var unl: i64 = 0 as i64;
    var s_ptr: *char = 0 as *char;
    var s_len: i64 = 0 as i64;

    if (get != 0 && pl == (5 as i64) && strncmp(path, "/feed", 5 as i64) == 0) {
        kind = Q_FEED;
    } else if (get != 0 && pl == (7 as i64) && strncmp(path, "/health", 7 as i64) == 0) {
        kind = Q_HEALTH;
    } else if (pl > (7 as i64) && strncmp(path, "/posts/", 7 as i64) == 0) {
        var seg: *char = (path as i64 + 7 as i64) as *char;
        var seg_len: i64 = pl - (7 as i64);
        var slash: *void = memchr(seg as *void, '/' as int, seg_len);
        if (get != 0 && slash as i64 == 0 as i64) {
            id = parse_positive_id(seg, seg_len);
            if (id < (0 as i64)) {
                err_resp(400, "invalid post id", close_conn);
                return;
            }
            kind = Q_POST;
        } else if (post != 0 && slash as i64 != 0 as i64) {
            var after_slash: *char = slash as *char;
            var after_len: i64 = (path as i64 + pl) - after_slash as i64;
            if (after_len == (5 as i64) && strncmp(after_slash, "/like", 5 as i64) == 0) {
                var auth_err: *char = verify_auth(authh, al, &uid, &uname[0], &unl);
                if (auth_err as i64 != 0 as i64) {
                    err_resp(401, auth_err, close_conn);
                    return;
                }
                var id_part_len: i64 = after_slash as i64 - seg as i64;
                id = parse_positive_id(seg, id_part_len);
                if (id < (0 as i64)) {
                    err_resp(400, "invalid post id", close_conn);
                    return;
                }
                kind = Q_LIKE;
            }
        }
    } else if (post != 0 && pl == (6 as i64) && strncmp(path, "/posts", 6 as i64) == 0) {
        var auth_err: *char = verify_auth(authh, al, &uid, &uname[0], &unl);
        if (auth_err as i64 != 0 as i64) {
            err_resp(401, auth_err, close_conn);
            return;
        }

        var bj: *char = body;
        var be: *char = (body as i64 + bl) as *char;
        skip_ws(&bj, be);
        if (bj as i64 >= be as i64 || *bj != '{') {
            err_resp(400, "malformed JSON body", close_conn);
            return;
        }
        bj = (bj as i64 + 1 as i64) as *char;

        var found_body: int = 0;
        var post_txt: [char; 65536] = uninit;
        var txt_len: i64 = 0 as i64;

        for (;;) {
            skip_ws(&bj, be);
            if (bj as i64 >= be as i64) {
                err_resp(400, "malformed JSON body", close_conn);
                return;
            }
            if (*bj == '}') { break; }
            var kbuf: [char; 32] = uninit;
            var kl: i64 = parse_json_str(&bj, be, &kbuf[0], 31 as i64);
            if (kl < (0 as i64)) {
                err_resp(400, "malformed JSON body", close_conn);
                return;
            }
            kbuf[kl as int] = 0 as char;
            skip_ws(&bj, be);
            if (bj as i64 >= be as i64 || *bj != ':') {
                err_resp(400, "malformed JSON body", close_conn);
                return;
            }
            bj = (bj as i64 + 1 as i64) as *char;
            skip_ws(&bj, be);

            if (strcmp(&kbuf[0], "body") == 0) {
                if (bj as i64 >= be as i64 || *bj != '"') {
                    err_resp(400, "body is required", close_conn);
                    return;
                }
                txt_len = parse_json_str(&bj, be, &post_txt[0], 65535 as i64);
                if (txt_len < (0 as i64)) {
                    err_resp(400, "malformed JSON body", close_conn);
                    return;
                }
                found_body = 1;
            } else {
                if (skip_json_val(&bj, be, 1) == 0) {
                    err_resp(400, "malformed JSON body", close_conn);
                    return;
                }
            }

            skip_ws(&bj, be);
            if (bj as i64 < be as i64 && *bj == ',') {
                bj = (bj as i64 + 1 as i64) as *char;
                continue;
            }
            if (bj as i64 < be as i64 && *bj == '}') {
                break;
            }
            err_resp(400, "malformed JSON body", close_conn);
            return;
        }

        if (found_body == 0) {
            err_resp(400, "body is required", close_conn);
            return;
        }

        var ts_start: *u8 = (&post_txt[0]) as *u8;
        var ts_end: *u8 = (ts_start as i64 + txt_len) as *u8;
        while (ts_start as i64 < ts_end as i64) {
            var step: int = jsws_at(ts_start, ts_end);
            if (step > 0) {
                ts_start = (ts_start as i64 + step as i64) as *u8;
            } else {
                break;
            }
        }
        while (ts_end as i64 > ts_start as i64) {
            var step: int = jsws_before(ts_start, ts_end);
            if (step > 0) {
                ts_end = (ts_end as i64 - step as i64) as *u8;
            } else {
                break;
            }
        }

        if (ts_start as i64 == ts_end as i64) {
            err_resp(400, "body is required", close_conn);
            return;
        }

        var char_count: i64 = 0 as i64;
        var p_cnt: *u8 = ts_start;
        while (p_cnt as i64 < ts_end as i64) {
            if ((*p_cnt & (0xC0 as u8)) != (0x80 as u8)) {
                char_count = char_count + (1 as i64);
            }
            p_cnt = (p_cnt as i64 + 1 as i64) as *u8;
        }
        if (char_count > (500 as i64)) {
            err_resp(400, "body must be at most 500 characters", close_conn);
            return;
        }

        s_ptr = ts_start as *char;
        s_len = ts_end as i64 - ts_start as i64;
        kind = Q_INS;
    }

    if (kind == (255 as u8)) {
        err_resp(404, "not found", close_conn);
        return;
    }

    if (enqueue_query(fd, kind, close_conn, id, uid, s_ptr, s_len, &uname[0], unl) != 0) {
        var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
        c->busy = 1 as u8;
        return;
    }

    if (kind != Q_HEALTH) {
        err_resp(500, "internal server error", close_conn);
        return;
    }
    begin_resp(503, close_conn);
    puts_lit("{\"status\":\"degraded\",\"db\":\"unreachable\",\"error\":\"no database connection\"}");
    finish_resp();
}

func accepts_gzip(v: *char, ve: *char) -> int {
    var g: *char = memmem(v, (ve as u64) - (v as u64), "gzip", 4 as u64) as *char;
    if (g as i64 == 0 as i64) { return 0; }
    g = (g as i64 + 4 as i64) as *char;
    while (g as i64 < ve as i64 && *g == ' ') {
        g = (g as i64 + 1 as i64) as *char;
    }
    if ((ve as i64 - g as i64) >= (3 as i64) && *g == ';') {
        var qp: *char = memmem(g, (ve as u64) - (g as u64), "q=", 2 as u64) as *char;
        if (qp as i64 != 0 as i64) {
            qp = (qp as i64 + 2 as i64) as *char;
            if (qp as i64 < ve as i64 && *qp == '0') {
                qp = (qp as i64 + 1 as i64) as *char;
                if (qp as i64 == ve as i64 || *qp == ' ' || *qp == ',' || *qp == ';') {
                    return 0;
                }
            }
        }
    }
    return 1;
}

func serve_http(fd: int, buf: *char, n: i64) -> i64 {
    var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
    var used: i64 = 0 as i64;

    while (used < n && c->open != (0 as u8) && c->busy == (0 as u8) && c->closing == (0 as u8) && c->out_buf as i64 == 0 as i64) {
        var p: *char = (buf as i64 + used) as *char;
        var rem: i64 = n - used;
        var he: *char = memmem(p, rem as u64, "\r\n\r\n", 4 as u64);
        if (he as i64 == 0 as i64) {
            if (rem > MAX_REQ) { return -1 as i64; }
            break;
        }

        var le: *char = memchr(p as *void, '\r' as int, (he as i64 + 2 as i64) - p as i64) as *char;
        if (le as i64 == 0 as i64) { return -1 as i64; }
        var m: *char = p;
        var sp1: *char = memchr(m as *void, ' ' as int, le as i64 - m as i64) as *char;
        if (sp1 as i64 == 0 as i64) { return -1 as i64; }
        var path: *char = (sp1 as i64 + 1 as i64) as *char;
        var sp2: *char = memchr(path as *void, ' ' as int, le as i64 - path as i64) as *char;
        if (sp2 as i64 == 0 as i64) { return -1 as i64; }

        var http10: int = ((le as i64 - (sp2 as i64 + 1 as i64)) == (8 as i64) && strncmp((sp2 as i64 + 1 as i64) as *char, "HTTP/1.0", 8 as i64) == 0) ? 1 : 0;
        var authh: *char = 0 as *char;
        var al: i64 = 0 as i64;
        var clen: i64 = 0 as i64;
        var close_conn: int = http10;
        var expect_continue: int = 0;
        g_want_gz = 0;

        var h: *char = (le as i64 + 2 as i64) as *char;
        var h_end: *char = (he as i64 + 2 as i64) as *char;

        while (h as i64 < h_end as i64) {
            var hl: *char = memchr(h as *void, '\r' as int, h_end as i64 - h as i64) as *char;
            if (hl as i64 == 0 as i64) { break; }
            var col: *char = memchr(h as *void, ':' as int, hl as i64 - h as i64) as *char;
            if (col as i64 != 0 as i64) {
                var v: *char = (col as i64 + 1 as i64) as *char;
                while (v as i64 < hl as i64 && (*v == ' ' || *v == '\t')) {
                    v = (v as i64 + 1 as i64) as *char;
                }
                var ve: *char = hl;
                while (ve as i64 > v as i64) {
                    var prev: char = *(((ve as i64) - (1 as i64)) as *char);
                    if (prev == ' ' || prev == '\t') {
                        ve = (ve as i64 - 1 as i64) as *char;
                    } else {
                        break;
                    }
                }
                var kn: i64 = col as i64 - h as i64;
                var vl: i64 = ve as i64 - v as i64;

                if (kn == (14 as i64) && strncasecmp(h, "content-length", 14 as i64) == 0) {
                    clen = 0 as i64;
                    var dp: *char = v;
                    while (dp as i64 < ve as i64) {
                        var dc: char = *dp;
                        if (dc < '0' || dc > '9') { return -1 as i64; }
                        clen = clen * (10 as i64) + ((dc as i64) - (48 as i64));
                        if (clen > MAX_REQ) { return -1 as i64; }
                        dp = (dp as i64 + 1 as i64) as *char;
                    }
                } else if (kn == (13 as i64) && strncasecmp(h, "authorization", 13 as i64) == 0) {
                    authh = v;
                    al = vl;
                } else if (kn == (10 as i64) && strncasecmp(h, "connection", 10 as i64) == 0) {
                    if (vl == (5 as i64) && strncasecmp(v, "close", 5 as i64) == 0) {
                        close_conn = 1;
                    } else if (vl == (10 as i64) && strncasecmp(v, "keep-alive", 10 as i64) == 0) {
                        close_conn = 0;
                    }
                } else if (kn == (15 as i64) && strncasecmp(h, "accept-encoding", 15 as i64) == 0) {
                    g_want_gz = accepts_gzip(v, ve);
                } else if (kn == (6 as i64) && strncasecmp(h, "expect", 6 as i64) == 0) {
                    if (vl == (12 as i64) && strncasecmp(v, "100-continue", 12 as i64) == 0) {
                        expect_continue = 1;
                    }
                } else if (kn == (17 as i64) && strncasecmp(h, "transfer-encoding", 17 as i64) == 0) {
                    return -1 as i64;
                }
            }
            h = (hl as i64 + 2 as i64) as *char;
        }

        var body_ptr: *char = (he as i64 + 4 as i64) as *char;
        var avail_body: i64 = (buf as i64 + n) - body_ptr as i64;
        if (avail_body < clen) {
            if (expect_continue != 0 && avail_body == (0 as i64)) {
                var cont: *char = "HTTP/1.1 100 Continue\r\n\r\n";
                if (write(fd, cont as *void, 25 as i64) < (0 as i64)) { return -1 as i64; }
            }
            break;
        }

        used = (body_ptr as i64 + clen) - buf as i64;
        handle_request(fd, m, sp1 as i64 - m as i64, path, sp2 as i64 - path as i64, authh, al, body_ptr, clen, close_conn);
        if (c->busy == (0 as u8)) {
            send_resp(fd, close_conn);
        }
    }
    return used;
}

func process_client(ep: int, fd: int, buf: *char, n: i64) -> void {
    var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
    var used: i64 = serve_http(fd, buf, n);
    if (c->open == (0 as u8)) { return; }
    if (used < (0 as i64)) {
        conn_close(fd);
        return;
    }
    var left: i64 = (c->closing != (0 as u8)) ? (0 as i64) : (n - used);
    if (left > (0 as i64)) {
        if (buf as i64 != c->in_buf as i64) {
            c->incap = (left + RBUF_SIZE) as u32;
            c->in_buf = malloc(c->incap as i64) as *char;
            memcpy(c->in_buf as *void, (buf as i64 + used) as *void, left);
        } else if (used > (0 as i64)) {
            memmove(c->in_buf as *void, (c->in_buf as i64 + used) as *void, left);
        }
        c->in_len = left as u32;
    } else if (c->in_buf as i64 != 0 as i64) {
        free(c->in_buf as *void);
        c->in_buf = 0 as *char;
        c->in_len = 0 as u32;
        c->incap = 0 as u32;
    }
}

func on_readable(fd: int) -> void {
    var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
    var r: i64 = 0 as i64;
    if (c->in_len > (0 as u32) || c->busy != (0 as u8)) {
        if ((c->incap - c->in_len) < (4096 as u32)) {
            if (c->incap > (4 * MAX_REQ as u32)) {
                conn_close(fd);
                return;
            }
            var new_cap: u32 = c->incap * (2 as u32) + (RBUF_SIZE as u32);
            var new_buf: *char = malloc(new_cap as i64) as *char;
            if (c->in_len > (0 as u32)) {
                memcpy(new_buf as *void, c->in_buf as *void, c->in_len as i64);
            }
            if (c->in_buf as i64 != 0 as i64) { free(c->in_buf as *void); }
            c->in_buf = new_buf;
            c->incap = new_cap;
        }
        r = read(fd, (c->in_buf as i64 + c->in_len as i64) as *void, (c->incap - c->in_len) as i64);
        if (r <= (0 as i64)) {
            if (r < (0 as i64)) { return; }
            conn_close(fd);
            return;
        }
        c->in_len = c->in_len + (r as u32);
        if (c->busy == (0 as u8)) {
            process_client(g_ep, fd, c->in_buf, c->in_len as i64);
        }
    } else {
        r = read(fd, g_rbuf as *void, RBUF_SIZE);
        if (r <= (0 as i64)) {
            if (r < (0 as i64)) { return; }
            conn_close(fd);
            return;
        }
        process_client(g_ep, fd, g_rbuf, r);
    }
}

func on_writable(fd: int) -> void {
    var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
    if (c->out_buf as i64 == 0 as i64) { return; }
    var w: i64 = write(fd, (c->out_buf as i64 + c->out_off as i64) as *void, (c->out_len - c->out_off) as i64);
    if (w < (0 as i64)) { return; }
    c->out_off = c->out_off + (w as u32);
    if (c->out_off < c->out_len) { return; }
    free(c->out_buf as *void);
    c->out_buf = 0 as *char;
    c->out_len = 0 as u32;
    c->out_off = 0 as u32;
    if (c->closing != (0 as u8)) {
        conn_close(fd);
        return;
    }
    ep_set(g_ep, EPOLL_CTL_MOD, fd, fd as u64, EPOLLIN);
    if (c->in_len > (0 as u32) && c->busy == (0 as u8)) {
        process_client(g_ep, fd, c->in_buf, c->in_len as i64);
    }
}

func listen_on(port: int) -> int {
    var fd: int = socket(AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
    var one: int = 1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (&one) as *void, 4 as u32);
    setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, (&one) as *void, 4 as u32);
    setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, (&one) as *void, 4 as u32);

    var a: SockAddrIn = uninit;
    memset((&a) as *void, 0, sizeof(SockAddrIn) as i64);
    a.sin_family = AF_INET as u16;
    a.sin_port = htons(port as u16);
    if (inet_pton(AF_INET, g_host, (&a.sin_addr) as *void) != 1) {
        puts("bad HOST address");
        exit(1);
    }
    if (bind(fd, (&a) as *void, sizeof(SockAddrIn) as u32) != 0 || listen(fd, 65535) != 0) {
        puts("bind or listen failed");
        exit(1);
    }
    return fd;
}

func accept_connections(lfd: int) -> void {
    for (var k: int = 0; k < 256; k = k + 1) {
        var c: int = accept4(lfd, 0 as *void, 0 as *void, SOCK_NONBLOCK | SOCK_CLOEXEC);
        if (c < 0) { return; }
        if ((c as i64) >= g_maxfd) {
            close(c);
        } else {
            var conn: *Connection = (g_conns as i64 + (c as i64) * (sizeof(Connection) as i64)) as *Connection;
            conn->open = 1 as u8;
            ep_set(g_ep, EPOLL_CTL_ADD, c, c as u64, EPOLLIN);
        }
    }
}

func run_worker(worker_idx: int, core_id: int) -> void {
    var mask: [u64; 16] = [0 as u64, ...];
    mask[core_id / 64] = (1 as u64) << (core_id % 64);
    sched_setaffinity(0, 128 as u64, (&mask[0]) as *void);

    g_arena = malloc(ARENA_SIZE) as *char;
    g_zbuf = malloc(ARENA_SIZE) as *char;
    g_rbuf = malloc(RBUF_SIZE) as *char;
    g_deflate_comp = libdeflate_alloc_compressor(1);
    g_conns = calloc(g_maxfd as u64, sizeof(Connection) as u64) as *Connection;

    g_ep = epoll_create1(EPOLL_CLOEXEC);
    g_pg = calloc(g_npg as u64, sizeof(PgConn) as u64) as *PgConn;

    for (var i: int = 0; i < g_npg; i = i + 1) {
        pg_connect(i);
    }

    g_lfd1 = listen_on(g_port1);
    ep_set(g_ep, EPOLL_CTL_ADD, g_lfd1, TAG_LISTEN_BASE | (0 as u64), EPOLLIN);
    if (g_port2 > 0) {
        g_lfd2 = listen_on(g_port2);
        ep_set(g_ep, EPOLL_CTL_ADD, g_lfd2, TAG_LISTEN_BASE | (1 as u64), EPOLLIN);
    }

    var evs: [EpollEvent; 512] = uninit;
    for (;;) {
        var n: int = epoll_wait(g_ep, (&evs[0]) as *void, 512, 1000);
        if (n < 0) { continue; }
        g_now_s = time(0 as *void);

        for (var ei: int = 0; ei < n; ei = ei + 1) {
            var tag: u64 = evs[ei].data_u64;
            var events: u32 = evs[ei].events;

            if (tag >= TAG_PG_BASE) {
                var pg_idx: int = (tag & (0xFFFFFFFF as u64)) as int;
                var p: *PgConn = (g_pg as i64 + (pg_idx as i64) * (sizeof(PgConn) as i64)) as *PgConn;
                if (p->c as i64 != 0 as i64) {
                    if ((events & (EPOLLIN | EPOLLHUP | EPOLLERR)) != (0 as u32)) {
                        pg_read(p);
                    }
                    if (p->c as i64 != 0 as i64 && (events & EPOLLOUT) != (0 as u32)) {
                        p->dirty = 1 as u8;
                    }
                }
            } else if (tag >= TAG_LISTEN_BASE) {
                var l_idx: int = (tag & (0xFFFFFFFF as u64)) as int;
                if (l_idx == 0) {
                    accept_connections(g_lfd1);
                } else {
                    accept_connections(g_lfd2);
                }
            } else {
                var fd: int = tag as int;
                var c: *Connection = (g_conns as i64 + (fd as i64) * (sizeof(Connection) as i64)) as *Connection;
                if (c->open != (0 as u8)) {
                    if ((events & EPOLLOUT) != (0 as u32)) {
                        on_writable(fd);
                    } else if ((events & (EPOLLIN | EPOLLHUP | EPOLLERR)) != (0 as u32)) {
                        on_readable(fd);
                    }
                }
            }
        }

        for (var i: int = 0; i < g_npg; i = i + 1) {
            var p: *PgConn = (g_pg as i64 + (i as i64) * (sizeof(PgConn) as i64)) as *PgConn;
            if (p->c as i64 != 0 as i64 && p->dirty != (0 as u8)) {
                if (p->unsynced != (0 as u8)) {
                    pg_sync(p);
                }
                p->dirty = 0 as u8;
                p->inbatch = 0 as u16;
                pg_flush(p, i);
            }
        }

        if (n > 0 && n < BATCH_MIN) {
            var ts: TimeSpec = uninit;
            ts.tv_sec = 0 as i64;
            ts.tv_nsec = 2000000 as i64;
            nanosleep((&ts) as *void, 0 as *void);
        }
    }
}

func _start() -> void {
    signal(13, 1 as *void); // SIG_IGN on SIGPIPE

    g_dburl = getenv("DATABASE_URL");
    g_jwt_secret = getenv("JWT_SECRET");
    if (g_dburl as i64 == 0 as i64 || g_jwt_secret as i64 == 0 as i64) {
        puts("DATABASE_URL and JWT_SECRET are required");
        exit(1);
    }
    g_jwt_secret_len = strlen(g_jwt_secret) as int;

    var host_env: *char = getenv("HOST");
    g_host = "0.0.0.0";
    if (host_env as i64 != 0 as i64) {
        g_host = host_env;
    }

    var port_env: *char = getenv("PORT");
    if (port_env as i64 != 0 as i64) { g_port1 = atoi(port_env); }

    var extra_env: *char = getenv("EXTRA_PORT");
    if (extra_env as i64 != 0 as i64 && *extra_env != (0 as char)) {
        g_port2 = atoi(extra_env);
    }

    var rl: RLimit = uninit;
    getrlimit(RLIMIT_NOFILE, (&rl) as *void);
    if (rl.rlim_cur < rl.rlim_max) {
        rl.rlim_cur = rl.rlim_max;
        setrlimit(RLIMIT_NOFILE, (&rl) as *void);
    }
    g_maxfd = (rl.rlim_cur > (8388608 as u64)) ? (8388608 as i64) : (rl.rlim_cur as i64);

    init_b64_table();
    g_started = time(0 as *void);

    var mask: [u64; 16] = [0 as u64, ...];
    var aff_res: int = sched_getaffinity(0, 128 as u64, (&mask[0]) as *void);
    var num_cpus: int = 0;
    var cpu_ids: [int; 128] = uninit;
    if (aff_res == 0) {
        for (var w: int = 0; w < 16; w = w + 1) {
            var word: u64 = mask[w];
            for (var b: int = 0; b < 64; b = b + 1) {
                if ((word & ((1 as u64) << b)) != (0 as u64)) {
                    if (num_cpus < 128) {
                        cpu_ids[num_cpus] = w * 64 + b;
                        num_cpus = num_cpus + 1;
                    }
                }
            }
        }
    }
    if (num_cpus == 0) {
        var n_onln: i64 = sysconf(84); // _SC_NPROCESSORS_ONLN
        num_cpus = (n_onln > (0 as i64)) ? (n_onln as int) : 1;
        for (var ci: int = 0; ci < num_cpus && ci < 128; ci = ci + 1) {
            cpu_ids[ci] = ci;
        }
    }

    g_npg = 64 / num_cpus;
    if (g_npg < 2) { g_npg = 2; }

    printf("== [Cider] Million Users Server starting with workers...\n");

    for (var wi: int = 0; wi < num_cpus; wi = wi + 1) {
        var pid: int = fork();
        if (pid == 0) {
            run_worker(wi, cpu_ids[wi]);
            exit(0);
        }
    }

    for (;;) {
        var status: int = 0;
        var p: int = waitpid(-1, &status, 0);
        if (p < 0) { break; }
    }
    exit(0);
}
